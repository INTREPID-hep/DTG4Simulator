// Materials for DT detector
// NIST materials (G4_AIR, G4_Al, G4_Fe, G4_Galactic) can be used directly
// Only define custom mixtures here

// Gas mixture for drift tubes (85% Ar + 15% CO2) by weight fraction
// Using air density: 1.214 mg/cm3 = 1.214E-3 g/cm3
:MIXT GasMixture 1.214E-03*g/cm3 2 //5.45E-1*g/cm3 2 
  G4_Ar 0.85
  G4_CARBON_DIOXIDE 0.15

// Air with low density (vacuum-like, 1e-5 of normal air density)
// Normal air density is ~1.214 mg/cm3, so low density = 1.214E-8 g/cm3
:MIXT Air_lowDensity 1.214E-08*g/cm3 2
  G4_N 0.7
  G4_O 0.3

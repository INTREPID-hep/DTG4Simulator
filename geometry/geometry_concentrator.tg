// DT Station Geometry Template
// This file contains fixed definitions
// Dynamic geometry is appended by generate_geometry_data.py

#include geometry/materials.txt

// World volume - box with CMS dimensions
:VOLU world BOX 800.*cm 800.*cm 750.*cm G4_Galactic
:VIS world ON //OFF
:COLOUR world 1.0 0.0 0.0 0.0 // RED

// Axis markers (for visualization)
// :SOLID AxisXSolid BOX 50.0 5.0 5.0
// :SOLID AxisYSolid BOX 5.0 50.0 5.0
// :SOLID AxisZSolid BOX 5.0 5.0 50.0
// 
// :VOLU AxisX AxisXSolid G4_Galactic
// :VOLU AxisY AxisYSolid G4_Galactic
// :VOLU AxisZ AxisZSolid G4_Galactic
// 
// :PLACE AxisX 1 world R0 100.0 0.0 0.0
// :PLACE AxisY 1 world R0 0.0 200.0 0.0
// :PLACE AxisZ 1 world R0 0.0 0.0 300.0

// Identity rotation matrix
:ROTM R0 0. 0. 0.

// ============================================================================
// Station geometries below (generated dynamically)
// ============================================================================
#include geometry/stations/station_W-1_Sec2_St2.tg
#include geometry/stations/station_W-1_Sec2_St1.tg
#include geometry/stations/station_W-1_Sec2_St3.tg
#include geometry/stations/station_W-1_Sec2_St4.tg

VIS: Station* ON
COLOUR: Station* 0.0 0.0 0.1 0.4 // Blue

VIS: Cell* ON
COLOUR: Cell* 1.0 1.0 0.0 0.8 // Yellow
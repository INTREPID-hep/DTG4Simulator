// Unified Yoke Assembly with Station Holes

// Base Iron Wedges (TUBS) for all sectors
// Wheel -1 Sector 1
:SOLID IronTrap_W-1_Sec1 TUBS 364.85*cm 536.02*cm 130.55*cm -15.00*deg 30.00*deg

// Union all sector wedges into single volume

// Subtract all station volumes to create holes
:SOLID Solid_Yoke_Sub1 SUBTRACTION IronTrap_W-1_Sec1 Solid_Station_W-1_Sec1_St1 RM_Station_-1_1_1 431.175000*cm 39.120000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub2 SUBTRACTION Solid_Yoke_Sub1 Solid_Station_W-1_Sec1_St2 RM_Station_-1_1_2 512.475000*cm -21.430000*cm 0.000000*cm

// Final yoke volume and placement
:VOLU Yoke_Fused Solid_Yoke_Sub2 G4_Fe
:PLACE Yoke_Fused 1 world R0 0*cm 0*cm -267.750000*cm

// Unified Yoke Assembly with Station Holes

// Base Iron Wedges (TUBS) for all sectors
// Wheel 0 Sector 12
:SOLID IronTrap_W0_Sec12 TUBS 404.85*cm 746.68*cm 130.55*cm 315.00*deg 30.00*deg
// Wheel 0 Sector 1
:SOLID IronTrap_W0_Sec1 TUBS 404.85*cm 747.72*cm 130.55*cm -15.00*deg 30.00*deg
// Wheel 0 Sector 2
:SOLID IronTrap_W0_Sec2 TUBS 404.85*cm 747.73*cm 130.55*cm 15.00*deg 30.00*deg

// Union all sector wedges into single volume
:SOLID Solid_Union_1 UNION IronTrap_W0_Sec1 IronTrap_W0_Sec2 R0 0*cm 0*cm -1.700000*cm
:SOLID Solid_Union_2 UNION Solid_Union_1 IronTrap_W0_Sec12 R0 0*cm 0*cm 0.000000*cm

// Subtract all station volumes to create holes
:SOLID Solid_Yoke_Sub1 SUBTRACTION Solid_Union_2 Solid_Station_W0_Sec12_St1 RM_Station_0_12_1 392.969000*cm -181.709000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub2 SUBTRACTION Solid_Yoke_Sub1 Solid_Station_W0_Sec12_St2 RM_Station_0_12_2 433.101000*cm -274.796000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub3 SUBTRACTION Solid_Yoke_Sub2 Solid_Station_W0_Sec12_St3 RM_Station_0_12_3 546.135000*cm -289.816000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub4 SUBTRACTION Solid_Yoke_Sub3 Solid_Station_W0_Sec12_St4 RM_Station_0_12_4 580.461000*cm -435.011000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub5 SUBTRACTION Solid_Yoke_Sub4 Solid_Station_W0_Sec1_St1 RM_Station_0_1_1 431.175000*cm 39.120000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub6 SUBTRACTION Solid_Yoke_Sub5 Solid_Station_W0_Sec1_St2 RM_Station_0_1_2 512.475000*cm -21.430000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub7 SUBTRACTION Solid_Yoke_Sub6 Solid_Station_W0_Sec1_St3 RM_Station_0_1_3 617.875000*cm 22.080000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub8 SUBTRACTION Solid_Yoke_Sub7 Solid_Station_W0_Sec1_St4 RM_Station_0_1_4 720.200000*cm -94.895000*cm 0.000000*cm
:SOLID Solid_Yoke_Sub9 SUBTRACTION Solid_Yoke_Sub8 Solid_Station_W0_Sec2_St1 RM_Station_0_2_1 353.849000*cm 249.466000*cm -1.700000*cm
:SOLID Solid_Yoke_Sub10 SUBTRACTION Solid_Yoke_Sub9 Solid_Station_W0_Sec2_St2 RM_Station_0_2_2 454.531000*cm 237.679000*cm -1.700000*cm
:SOLID Solid_Yoke_Sub11 SUBTRACTION Solid_Yoke_Sub10 Solid_Station_W0_Sec2_St3 RM_Station_0_2_3 524.055000*cm 328.059000*cm -1.700000*cm
:SOLID Solid_Yoke_Sub12 SUBTRACTION Solid_Yoke_Sub11 Solid_Station_W0_Sec2_St4 RM_Station_0_2_4 671.159000*cm 277.919000*cm -1.700000*cm

// Final yoke volume and placement
:VOLU Yoke_Fused Solid_Yoke_Sub12 G4_Fe
:PLACE Yoke_Fused 1 world R0 0*cm 0*cm 0.850000*cm

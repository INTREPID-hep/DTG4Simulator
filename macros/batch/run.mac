# Batch mode execution macro for DTSim
# Usage: ./exampleDTSim macros/batch/run.mac

# Set aliases for parameters
/control/alias nThreads 4
/control/alias sed1 123
/control/alias sed2 456
/control/alias outdir .
/control/alias tag _test
/control/execute macros/batch/run_setup.mac

# Run simulation
/run/beamOn 1000

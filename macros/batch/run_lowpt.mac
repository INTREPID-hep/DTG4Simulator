# Low-pT particle scan batch run for DTSim
# Usage: ./exampleDTSim -m macros/batch/run_lowpt.mac

# Load standard settings
/control/execute macros/settings/verbosity.mac
/control/execute macros/settings/physics.mac

# Set number of threads for parallel execution
/run/numberOfThreads 4

# Initialize kernel
/run/initialize

# Override primary settings for low-pT mixed particles
/DTSim/generator/randomizePrimary true
/DTSim/generator/momentum 10 GeV
/DTSim/generator/sigmaMomentum 2 GeV
/DTSim/generator/sigmaAngle 5 deg
/gun/position 0. 0. -0.25 m

# Run simulation
/run/beamOn 100

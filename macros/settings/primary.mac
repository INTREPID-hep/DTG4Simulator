# Primary particle generation settings for DTSim
# Include this in your macros with: /control/execute macros/settings/primary.mac

# Default primary particle configuration
# Set primary momentum (default: 300 GeV)
/DTSim/generator/momentum 300 GeV

# Set momentum spread/sigma (default: 0 MeV)
/DTSim/generator/sigmaMomentum 100 MeV

# Set angular divergence/spread (default: 0 degrees)
/DTSim/generator/sigmaAngle 5 deg

# Randomize primary particle type (true/false)
# If true, randomly selects from: e+, mu+, pi+, kaon+, proton
# If false, use the particle set with /gun/particle command
/DTSim/generator/randomizePrimary false

# Set specific particle type (used when randomizePrimary is false)
/gun/particle mu+

# Gun position - start point for primary particles
/gun/position 0. 0. -0.25 m

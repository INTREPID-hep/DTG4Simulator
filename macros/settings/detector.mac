# Detector configuration settings for DTSim
# Include this in your macros BEFORE /run/initialize with: /control/execute macros/settings/detector.mac
# NOTE: These settings must be configured before initialization. Runtime changes require restarting.

# ========== Geometry Configuration ==========
# Set geometry file to load (relative to working directory)
/DTSim/detector/setGeometryFile geometry/geometry_concentrator.tg

# ========== Sensitive Detector Configuration ==========
# Enable/disable DriftCell sensitive detector (records hits in drift tubes)
/DTSim/detector/enableDriftSD true

# Enable/disable Station sensitive detector (records truth segments)
/DTSim/detector/enableStationSD true

# ========== Magnetic Field Configuration ==========
# Enable/disable magnetic field (also requires -B command line flag)
/DTSim/detector/useBField false

# Set global magnetic field vector (x, y, z) in tesla
# Default: (0, 0, 0) T - no global field
/DTSim/detector/BField/setGlobal 0 0 0 tesla

# Set yoke magnetic field vector (x, y, z) in tesla
# Default: (0, 0, -2.0) T - matches CMS return yoke field
/DTSim/detector/BField/setYoke 0 0 -2.0 tesla
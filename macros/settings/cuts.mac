# ==============================================================================
# Physics Cuts Configuration
# ==============================================================================
# These commands must be executed BEFORE /run/initialize.
# This macro defines the production cuts (production thresholds for secondary particles)
# Smaller cuts = more accurate but slower simulation
# Larger cuts = faster but less detail in secondary particle production

# Global production cut
# Default is typically 0.7 mm (1 mm in some physics lists)
/run/setCut 50 mm

# Set region-specific cuts for fine control
# Use smaller cuts in sensitive detectors, larger in passive material
/run/setCutForRegion StationRegion 5 mm

# Set cuts for specific particles (overrides global cut)
# /run/setCutForAGivenParticle e- 0.05 mm
# /run/setCutForAGivenParticle e+ 0.05 mm
# /run/setCutForAGivenParticle gamma 0.1 mm
# /run/setCutForAGivenParticle proton 0.1 mm

# Particle-specific cuts in a region
# /run/setCutForRegionAndParticle <region_name> e- 0.01 mm

# Apply cuts to specific materials (energy threshold)
# /run/setCutForMaterial <material_name> 0.05 mm

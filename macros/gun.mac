# Primary generator configuration macro
# This macro can be used to configure primary particle generation parameters at runtime
# Use with: /control/execute gun.mac

# Set primary momentum (in GeV)
# /DTSim/generator/momentum 1.0 GeV

# Set momentum spread/sigma (in MeV)
# /DTSim/generator/sigmaMomentum 50.0 MeV

# Set angular divergence/spread (in degrees)
# /DTSim/generator/sigmaAngle 2.0 deg

# Randomize primary particle type (true/false)
# If true, randomly selects from: e+, mu+, pi+, kaon+, proton
# If false, use the particle set with /gun/particle command
# /DTSim/generator/randomizePrimary true

# Alternative: Set specific particle type (only used if randomizePrimary is false)
# /DTSim/generator/randomizePrimary false
# /gun/particle mu+

# Gun position can be set with standard gun commands
# /gun/position 0. 0. -2.5 m

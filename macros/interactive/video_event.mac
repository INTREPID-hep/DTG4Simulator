# 1. Setup rich trajectories and time windowing (Before running)
/vis/scene/add/trajectories rich
/vis/modeling/trajectories/drawByParticleID-0/default/setTimeSliceInterval 0.05 ns
/vis/viewer/set/timeWindow/displayHeadTime true
/vis/viewer/set/timeWindow/fadeFactor 1

# 2. Generate the event
/run/beamOn 1

# 3. Save View 1 (Time 0, Viewpoint 0 0)
/vis/viewer/set/timeWindow/startTime 0 ns 0.1 ns
/vis/viewer/set/viewpointThetaPhi 0 0
/vis/viewer/refresh
/vis/viewer/save

# 4. Save View 2 (Time 10ns, Viewpoint 0.1 0.1) - TINY ROTATION
/vis/viewer/set/timeWindow/startTime 10 ns 0.1 ns
/vis/viewer/set/viewpointThetaPhi 0.1 0.1
/vis/viewer/refresh
/vis/viewer/save

# 5. Save View 3 (Time 30ns, Viewpoint 0.2 0.2) - TINY ROTATION
/vis/viewer/set/timeWindow/startTime 30 ns 0.1 ns
/vis/viewer/set/viewpointThetaPhi 0.2 0.2
/vis/viewer/refresh
/vis/viewer/save

# 6. Run the interpolation and export frames
/vis/viewer/interpolate 100 ! ! ! export